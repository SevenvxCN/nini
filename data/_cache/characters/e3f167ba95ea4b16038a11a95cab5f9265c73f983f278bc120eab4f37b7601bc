nd: linear-gradient(90deg, #3d3d5c 0%, #4d4d6c 50%, #3d3d5c 100%);\\n    }\\n\\n    .panel-header i.panel-icon {\\n      font-size: 1.2em;\\n      color: #ffd700;\\n      text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);\\n    }\\n\\n    .panel-title {\\n      font-family: 'Cinzel', 'Noto Serif SC', serif;\\n      font-size: 1.1em;\\n      font-weight: 700;\\n      color: #ffd700;\\n      text-shadow: 0 0 10px rgba(255, 215, 0, 0.3);\\n      letter-spacing: 2px;\\n      flex: 1;\\n    }\\n\\n    .panel-toggle {\\n      color: #8b7355;\\n      transition: transform 0.3s ease;\\n    }\\n\\n    .panel-header.collapsed .panel-toggle {\\n      transform: rotate(-90deg);\\n    }\\n\\n    /* ========== 面板内容样式 ========== */\\n    .panel-content {\\n      padding: 12px;\\n      transition: max-height 0.3s ease, padding 0.3s ease, opacity 0.3s ease;\\n      overflow: hidden;\\n    }\\n\\n    .panel-content.collapsed {\\n      max-height: 0;\\n      padding: 0 12px;\\n      opacity: 0;\\n    }\\n\\n    .data-row {\\n      background: rgba(0, 0, 0, 0.3);\\n      border: 1px solid rgba(139, 115, 85, 0.3);\\n      border-radius: 4px;\\n      padding: 8px 12px;\\n      margin-bottom: 6px;\\n      font-size: 0.9em;\\n      line-height: 1.5;\\n      /* 移动端友好：允许内容换行 */\\n      display: flex;\\n      flex-wrap: wrap;\\n      align-items: center;\\n      gap: 4px 8px;\\n    }\\n\\n    .data-row:last-child {\\n      margin-bottom: 0;\\n    }\\n\\n    /* ========== 标签样式 ========== */\\n    .tag {\\n      display: inline-block;\\n      padding: 2px 8px;\\n      border-radius: 3px;\\n      font-size: 0.85em;\\n      font-weight: 600;\\n      margin: 0 2px;\\n    }\\n\\n    .tag-round { background: #4a5568; color: #e2e8f0; }\\n    .tag-type { background: #553c9a; color: #e9d8fd; }\\n    .tag-env { background: #2c5282; color: #bee3f8; }\\n    .tag-hp { background: linear-gradient(135deg, #c53030, #9b2c2c); color: #fff; }\\n    .tag-mp { background: linear-gradient(135deg, #2b6cb0, #2c5282); color: #fff; }\\n    .tag-sp { background: linear-gradient(135deg, #38a169, #276749); color: #fff; }\\n\\n    /* ========== 属性值样式 ========== */\\n    .stat {\\n      display: inline-block;\\n      padding: 1px 6px;\\n      background: rgba(255, 215, 0, 0.15);\\n      border: 1px solid rgba(255, 215, 0, 0.3);\\n      border-radius: 3px;\\n      color: #ffd700;\\n      font-weight: 600;\\n      font-size: 0.9em;\\n      margin: 0 1px;\\n    }\\n\\n    .stat-str { border-color: #fc8181; color: #fc8181; background: rgba(252, 129, 129, 0.1); }\\n    .stat-agi { border-color: #68d391; color: #68d391; background: rgba(104, 211, 145, 0.1); }\\n    .stat-con { border-color: #f6ad55; color: #f6ad55; background: rgba(246, 173, 85, 0.1); }\\n    .stat-int { border-color: #63b3ed; color: #63b3ed; background: rgba(99, 179, 237, 0.1); }\\n    .stat-spi { border-color: #b794f4; color: #b794f4; background: rgba(183, 148, 244, 0.1); }\\n\\n    /* ========== 状态效果样式 ========== */\\n    .status-label {\\n      color: #805ad5;\\n      font-weight: 600;\\n    }\\n\\n    .status-effect {\\n      display: inline-block;\\n      padding: 2px 8px;\\n      background: rgba(128, 90, 213, 0.2);\\n      border: 1px solid #805ad5;\\n      border-radius: 10px;\\n      font-size: 0.85em;\\n      color: #d6bcfa;\\n      margin: 2px;\\n    }\\n\\n    .status-effect.debuff {\\n      background: rgba(229, 62, 62, 0.2);\\n      border-color: #e53e3e;\\n      color: #feb2b2;\\n    }\\n\\n    /* ========== 角色名样式 ========== */\\n    .char-name {\\n      font-weight: 700;\\n      color: #fbd38d;\\n      text-shadow: 0 0 5px rgba(251, 211, 141, 0.3);\\n    }\\n\\n    .char-name.player {\\n      color: #68d391;\\n    }\\n\\n    .char-name.enemy {\\n      color: #fc8181;\\n    }\\n  </style>\\n</head>\\n<body>\\n  <div id=\\\"content\\\">\\n    <!-- 渲染后的面板将显示在这里 -->\\n  </div>\\n\\n  <script>\\n    // ========== 模拟外部传入的单个 <action_info> 块 ==========\\n    // 实际使用时，外部会用正则匹配提取并传入单个块\\n    // 测试生产制作协议面板\\n    const mockBattleText = `$0`;\\n\\n    // ========== 面板类型配置 (仅使用 Font Awesome 免费版图标) ==========\\n    const PanelConfig = {\\n      // ===== 战斗协议面板 =====\\n      '战况总览': { icon: 'fa-solid fa-scroll', color: '#ffd700' },\\n      '行动顺序': { icon: 'fa-solid fa-hourglass-half', color: '#63b3ed' },\\n      '攻击行动': { icon: 'fa-solid fa-crosshairs', color: '#fc8181' },\\n      '伤害基准计算': { icon: 'fa-solid fa-calculator', color: '#f6ad55' },\\n      '结算清单': { icon: 'fa-solid fa-list-check', color: '#68d391' },\\n      '战术动作': { icon: 'fa-solid fa-chess', color: '#b794f4' },\\n      '战术动作 - 逃跑': { icon: 'fa-solid fa-person-running', color: '#fbd38d' },\\n      '战意判定': { icon: 'fa-solid fa-heart-crack', color: '#e53e3e' },\\n      '战斗胜利': { icon: 'fa-solid fa-trophy', color: '#ffd700' },\\n      '战斗失败': { icon: 'fa-solid fa-skull', color: '#718096' },\\n      // ===== 生产制作协议面板 =====\\n      '生产准备': { icon: 'fa-solid fa-toolbox', color: '#f6ad55' },\\n      '制作检定': { icon: 'fa-solid fa-dice-d20', color: '#63b3ed' },\\n      '结果结算': { icon: 'fa-solid fa-box-open', color: '#68d391' }\\n    };\\n\\n    // ========== 核心解析函数 (使用 lodash 优化) ==========\\n\\n    /**\\n     * 解析 <action_info> 标签内容\\n     * 支持两种输入格式：\\n     * @param {string} text - action_info 内容\\n     * @returns {Object} 解析后的面板对象\\n     */\\n    function parseActionInfo(text) {\\n      // 去除首尾空白\\n      let content = _.trim(text);\\n\\n      // 检查是否包含 <action_info> 标签\\n      const tagMatch = content.match(/<action_info>([\\\\s\\\\S]*?)<\\\\/action_info>/);\\n      if (tagMatch) {\\n        // 提取标签内部内容\\n        content = _.trim(tagMatch[1]);\\n      }\\n\\n      // 解析内容并返回\\n      return parsePanelContent(content);\\n    }\\n\\n    /**\\n     * 解析单个面板内容 (使用 lodash 链式操作)\\n     * @param {string} content - 面板内部文本\\n     * @returns {Object} 面板数据对象\\n     */\\n    function parsePanelContent(content) {\\n      const lines = _.chain(content)\\n        .split('\\\\n')\\n        .map(_.trim)\\n        .compact()\\n        .value();\\n\\n      const sections = [];\\n      let currentSection = null;\\n\\n      _.forEach(lines, line => {\\n        // 匹配模块标题 {xxx}\\n        const titleMatch = line.match(/^\\\\{(.+?)\\\\}$/);\\n        if (titleMatch) {\\n          if (currentSection) sections.push(currentSection);\\n          currentSection = { title: titleMatch[1], rows: [] };\\n          return;\\n        }\\n\\n        // 匹配数据行 | xxx |\\n        if (_.startsWith(line, '|') && _.endsWith(line, '|') && currentSection) {\\n          currentSection.rows.push(_.trim(line.slice(1, -1)));\\n        }\\n      });\\n\\n      if (currentSection) sections.push(currentSection);\\n      return { sections };\\n    }\\n\\n    /**\\n     * 美化数据行内容\\n     * @param {string} row - 原始数据行\\n     * @returns {string} 美化后的 HTML\\n     */\\n    function beautifyRow(row) {\\n      let html = row;\\n\\n      // HP 高亮 - HP X/X 或 HP [X/X]\\n      html = html.replace(/HP\\\\s*\\\\[?(\\\\d+)\\\\/(\\\\d+)\\\\]?/g, (match, current, max) => {\\n        const percent = (parseInt(current) / parseInt(max)) * 100;\\n        const colorClass = percent > 50 ? 'tag-hp' : (percent > 25 ? 'tag-mp' : 'tag-hp');\\n        return `<span class=\\\"tag ${colorClass}\\\"><i class=\\\"fa-solid fa-heart\\\"></i> HP ${current}/${max}</span>`;\\n      });\\n\\n      // MP 高亮\\n      html = html.replace(/MP\\\\s*\\\\[?(\\\\d+)\\\\/(\\\\d+)\\\\]?/g, (m, cur, max) =>\\n        `<span class=\\\"tag tag-mp\\\"><i class=\\\"fa-solid fa-droplet\\\"></i> MP ${cur}/${max}</span>`);\\n\\n      // SP 高亮\\n      html = html.replace(/SP\\\\s*\\\\[?(\\\\d+)\\\\/(\\\\d+)\\\\]?/g, (m, cur, max) =>\\n        `<span class=\\\"tag tag-sp\\\"><i class=\\\"fa-solid fa-bolt\\\"></i> SP ${cur}/${max}</span>`);\\n\\n      // 属性值高亮 - 使用函数回调保留前置分隔符，避免误匹配\\n      html = html.replace(/([\\\\s\\\\|])力\\\\[?(\\\\d+)\\\\]?/g, (m, sep, val) =>\\n        `${sep}<span class=\\\"stat stat-str\\\"><i class=\\\"fa-solid fa-dumbbell\\\"></i> 力量${val}</span>`);\\n      html = html.replace(/([\\\\s\\\\|])敏\\\\[?(\\\\d+)\\\\]?/g, (m, sep, val) =>\\n        `${sep}<span class=\\\"stat stat-agi\\\"><i class=\\\"fa-solid fa-feather-pointed\\\"></i> 敏捷${val}</span>`);\\n      html = html.replace(/([\\\\s\\\\|])体\\\\[?(\\\\d+)\\\\]?/g, (m, sep, val) =>\\n        `${sep}<span class=\\\"stat stat-con\\\"><i class=\\\"fa-solid fa-shield-heart\\\"></i> 体质${val}</span>`);\\n      html = html.replace(/([\\\\s\\\\|])智\\\\[?(\\\\d+)\\\\]?/g, (m, sep, val) =>\\n        `${sep}<span class=\\\"stat stat-int\\\"><i class=\\\"fa-solid fa-brain\\\"></i> 智力${val}</span>`);\\n      html = html.replace(/([\\\\s\\\\|])精\\\\[?(\\\\d+)\\\\]?/g, (m, sep, val) =>\\n        `${sep}<span class=\\\"stat stat-spi\\\"><i class=\\\"fa-solid fa-eye\\\"></i> 精神${val}</span>`);\\n\\n      // 回合数高亮\\n      html = html.replace(/回合:\\\\s*(\\\\d+)/g, (m, num) =>\\n        `<span class=\\\"tag tag-round\\\"><i class=\\\"fa-solid fa-rotate\\\"></i> 回合 ${num}</span>`);\\n\\n      // 类型高亮\\n      html = html.replace(/类型:\\\\s*(\\\\S+)/g, (m, type) =>\\n        `<span class=\\\"tag tag-type\\\"><i class=\\\"fa-solid fa-tag\\\"></i> ${type}</span>`);\\n\\n      // 环境高亮\\n      html = html.replace(/环境:\\\\s*([^|]+)/g, (m, env) =>\\n        `<span class=\\\"tag tag-env\\\"><i class=\\\"fa-solid fa-location-dot\\\"></i> ${env}</span>`);\\n\\n      // 状态行美化 - 去掉图标，优化对齐\\n      if (html.includes('状态:')) {\\n        html = html.replace(/状态:\\\\s*(.+)/g, (match, states) => {\\n          const stateList = states.split(',').map(s => s.trim()).filter(s => s);\\n          const stateHtml = stateList.map(state => {\\n            const durationMatch = state.match(/\\\\((\\\\d+)回合\\\\)/);\\n            const duration = durationMatch ? ` (${durationMatch[1]}回合)` : '';\\n            const stateName = state.replace(/\\\\(\\\\d+回合\\\\)/, '').trim();\\n            return `<span class=\\\"status-effect\\\">${stateName}${duration}</span>`;\\n          }).join('');\\n          return `<span class=\\\"status-label\\\">状态:</span> ${stateHtml}`;\\n        });\\n      }\\n\\n      // 结果高亮 - 使用函数回调\\n      html = html.replace(/结果:\\\\s*(胜利)/g, () =>\\n        '<span style=\\\"color:#68d391;font-weight:700;\\\"><i class=\\\"fa-solid fa-check-circle\\\"></i> 胜利</span>');\\n      html = html.replace(/结果:\\\\s*(失败)/g, () =>\\n        '<span style=\\\"color:#fc8181;font-weight:700;\\\"><i class=\\\"fa-solid fa-times-circle\\\"></i> 失败</span>');\\n      html = html.replace(/结果:\\\\s*(有效|暴击)/g, (m, res) =>\\n        `<span style=\\\"color:#68d391;font-weight:700;\\\">${res}</span>`);\\n      html = html.replace(/结果:\\\\s*(勉强)/g, (m, res) =>\\n        `<span style=\\\"color:#fbd38d;font-weight:700;\\\">${res}</span>`);\\n      html = html.replace(/结果:\\\\s*(擦伤|失手)/g, (m, res) =>\\n        `<span style=\\\"color:#fc8181;font-weight:700;\\\">${res}</span>`);\\n\\n      // EXP 和 FP 高亮 - 使用函数回调\\n      html = html.replace(/EXP\\\\s*\\\\+(\\\\d+)/g, (m, val) =>\\n        `<span style=\\\"color:#ffd700;font-weight:700;\\\"><i class=\\\"fa-solid fa-star\\\"></i> EXP +${val}</span>`);\\n      html = html.replace(/FP\\\\s*\\\\+(\\\\d+)/g, (m, val) =>\\n        `<span style=\\\"color:#b794f4;font-weight:700;\\\"><i class=\\\"fa-solid fa-gem\\\"></i> FP +${val}</span>`);\\n\\n      // 掉落物品高亮\\n      html = html.replace(/掉落:\\\\s*(.+)/g, (match, items) => {\\n        return `<i class=\\\"fa-solid fa-gift\\\" style=\\\"color:#fbd38d;\\\"></i> 掉落: <span style=\\\"color:#fbd38d;\\\">${items}</span>`;\\n      });\\n\\n      // 死亡/毁坏 高亮\\n      html = html.replace(/死亡\\\\/毁坏/g, '<span style=\\\"color:#e53e3e;font-weight:700;\\\"><i class=\\\"fa-solid fa-skull\\\"></i> 死亡</span>');\\n      html = html.replace(/未死\\\\/存活/g, '<span style=\\\"color:#68d391;font-weight:700;\\\"><i class=\\\"fa-solid fa-heart-pulse\\\"></i> 存活</span>');\\n\\n      // ===== 生产制作协议美化规则 =====\\n\\n      // 品质高亮（带颜色分级）\\n      html = html.replace(/品质:\\\\s*(普通)/g, (m, q) =>\\n        `品质: <span style=\\\"color:#a0aec0;font-weight:600;\\\">${q}</span>`);\\n      html = html.replace(/品质:\\\\s*(优良)/g, (m, q) =>\\n        `品质: <span style=\\\"color:#68d391;font-weight:600;\\\">${q}</span>`);\\n      html = html.replace(/品质:\\\\s*(稀有)/g, (m, q) =>\\n        `品质: <span style=\\\"color:#63b3ed;font-weight:600;\\\">${q}</span>`);\\n      html = html.replace(/品质:\\\\s*(史诗)/g, (m, q) =>\\n        `品质: <span style=\\\"color:#b794f4;font-weight:600;\\\">${q}</span>`);\\n      html = html.replace(/品质:\\\\s*(传说)/g, (m, q) =>\\n        `品质: <span style=\\\"color:#f6ad55;font-weight:600;\\\">${q}</span>`);\\n      html = html.replace(/品质:\\\\s*(神话)/g, (m, q) =>\\n        `品质: <span style=\\\"color:#fc8181;font-weight:600;text-shadow:0 0 8px rgba(252,129,129,0.5);\\\">${q}</span>`);\\n\\n      // 制作类型高亮\\n      html = html.replace(/类型:\\\\s*(锻造)/g, (m, t) =>\\n        `类型: <span class=\\\"tag\\\" style=\\\"background:#c53030;color:#fff;\\\"><i class=\\\"fa-solid fa-hammer\\\"></i> ${t}</span>`);\\n      html = html.replace(/类型:\\\\s*(炼金)/g, (m, t) =>\\n        `类型: <span class=\\\"tag\\\" style=\\\"background:#805ad5;color:#fff;\\\"><i class=\\\"fa-solid fa-flask\\\"></i> ${t}</span>`);\\n      html = html.replace(/类型:\\\\s*(烹饪)/g, (m, t) =>\\n        `类型: <span class=\\\"tag\\\" style=\\\"background:#dd6b20;color:#fff;\\\"><i class=\\\"fa-solid fa-utensils\\\"></i> ${t}</span>`);\\n      html = html.replace(/类型:\\\\s*(裁缝)/g, (m, t) =>\\n        `类型: <span class=\\\"tag\\\" style=\\\"background:#319795;color:#fff;\\\"><i class=\\\"fa-solid fa-scissors\\\"></i> ${t}</span>`);\\n\\n      // 核心属性高亮（生产类型关联）\\n      html = html.replace(/核心属性:\\\\s*(力量)/g, (m, a) =>\\n        `核心属性: <span class=\\\"stat stat-str\\\">${a}</span>`);\\n      html = html.replace(/核心属性:\\\\s*(智力)/g, (m, a) =>\\n        `核心属性: <span class=\\\"stat stat-int\\\">${a}</span>`);\\n      html = html.replace(/核心属性:\\\\s*(精神)/g, (m, a) =>\\n        `核心属性: <span class=\\\"stat stat-spi\\\">${a}</span>`);\\n      html = html.replace(/核心属性:\\\\s*(敏捷)/g, (m, a) =>\\n        `核心属性: <span class=\\\"stat stat-agi\\\">${a}</span>`);\\n\\n      // 制作检定结果\\n      html = html.replace(/检定结果:\\\\s*(大失败)/g, (m, r) =>\\n        `检定结果: <span style=\\\"color:#e53e3e;font-weight:700;\\\"><i class=\\\"fa-solid fa-skull-crossbones\\\"></i> ${r}</span>`);\\n      html = html.replace(/检定结果:\\\\s*(失败)/g, (m, r) =>\\n        `检定结果: <span style=\\\"color:#fc8181;font-weight:700;\\\"><i class=\\\"fa-solid fa-times\\\"></i> ${r}</span>`);\\n      html = html.replace(/检定结果:\\\\s*(成功)/g, (m, r) =>\\n        `检定结果: <span style=\\\"color:#68d391;font-weight:700;\\\"><i class=\\\"fa-solid fa-check\\\"></i> ${r}</span>`);\\n      html = html.replace(/检定结果:\\\\s*(精益求精)/g, (m, r) =>\\n        `检定结果: <span style=\\\"color:#ffd700;font-weight:700;text-shadow:0 0 8px rgba(255,215,0,0.5);\\\"><i class=\\\"fa-solid fa-star\\\"></i> ${r}</span>`);\\n\\n      // 制作状态\\n      html = html.replace(/状态:\\\\s*\\\\[?(制作失败)\\\\]?/g, (m, s) =>\\n        `状态: <span style=\\\"color:#fc8181;font-weight:700;\\\">${s}</span>`);\\n      html = html.replace(/状态:\\\\s*\\\\[?(制作成功)\\\\]?/g, (m, s) =>\\n        `状态: <span style=\\\"color:#68d391;font-weight:700;\\\">${s}</span>`);\\n      html = html.replace(/状态:\\\\s*\\\\[?(充足)\\\\]?/g, (m, s) =>\\n        `状态: <span style=\\\"color:#68d391;\\\">${s}</span>`);\\n      html = html.replace(/状态:\\\\s*\\\\[?(不足)\\\\]?/g, (m, s) =>\\n        `状态: <span style=\\\"color:#fc8181;\\\">${s}</span>`);\\n\\n      // DC和检定值高亮\\n      html = html.replace(/DC\\\\s*\\\\[?(\\\\d+)\\\\]?/g, (m, val) =>\\n        `<span style=\\\"color:#f6ad55;font-weight:600;\\\">DC ${val}</span>`);\\n      html = html.replace(/vs\\\\s+DC/g, () =>\\n        `<span style=\\\"color:#a0aec0;\\\">vs</span> DC`);\\n\\n      // 产出物品高亮\\n      html = html.replace(/产出:\\\\s*(.+)/g, (m, items) =>\\n        `<i class=\\\"fa-solid fa-box\\\" style=\\\"color:#68d391;\\\"></i> 产出: <span style=\\\"color:#68d391;\\\">${items}</span>`);\\n\\n      return html;\\n    }\\n\\n    /**\\n     * 渲染单个面板到 DOM (使用 jQuery 优化，支持折叠)\\n     * @param {Object} panel - 解析后的面板对象 { sections: [...] }\\n     * @param {string} containerSelector - 容器选择器\\n     * @param {boolean} append - 是否追加模式（默认清空后渲染）\\n     */\\n    function renderPanel(panel, containerSelector, append = false) {\\n      const $container = $(containerSelector);\\n      if (!append) $container.empty();\\n\\n      _.forEach(panel.sections, section => {\\n        // 获取面板配置\\n        const config = _.get(PanelConfig, section.title, {\\n          icon: 'fa-solid fa-circle-info',\\n          color: '#e8d5b7'\\n        });\\n\\n        // 构建面板 HTML\\n        const $panel = $('<div class=\\\"action-panel\\\">');\\n\\n        // 面板头部（可折叠）\\n        const $header = $(`\\n          <div class=\\\"panel-header\\\">\\n            <i class=\\\"panel-icon ${config.icon}\\\" style=\\\"color:${config.color};\\\"></i>\\n            <span class=\\\"panel-title\\\">${section.title}</span>\\n            <i class=\\\"panel-toggle fa-solid fa-chevron-down\\\"></i>\\n          </div>\\n        `);\\n\\n        // 折叠点击事件\\n        $header.on('click', function() {\\n          $(this).toggleClass('collapsed');\\n          $(this).siblings('.panel-content').toggleClass('collapsed');\\n        });\\n\\n        $panel.append($header);\\n\\n        // 面板内容\\n        const $content = $('<div class=\\\"panel-content\\\">');\\n        _.forEach(section.rows, row => {\\n          $content.append(`<div class=\\\"data-row\\\">${beautifyRow(row)}</div>`);\\n        });\\n\\n        $panel.append($content);\\n        $container.append($panel);\\n      });\\n    }\\n\\n    // ========== 初始化 (使用 jQuery) ==========\\n    $(() => {\\n      const panel = parseActionInfo(mockBattleText);\\n      renderPanel(panel, '#content');\\n    });\\n  </script>\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[1,2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minD