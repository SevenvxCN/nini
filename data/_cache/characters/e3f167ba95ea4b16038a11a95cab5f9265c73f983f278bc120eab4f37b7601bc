_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":26598,\"keys\":[\"炼金术师\",\"锻造师\",\"冒险者公会\",\"火花巷工匠区\",\"荆棘军营\",\"蔷薇之壁\"],\"secondary_keys\":[\"中城区\"],\"comment\":\"瓦伦蒂亚-中城区-中城地点(快乐柠萌茶)\",\"content\":\"  中城区地点:\\n    冒险者公会总部:\\n      位置: 中城区-中心广场北侧\\n      环境: 宏伟石砌圆顶建筑，内部魔法照明充足\\n      概况: 冒险者核心集散地与情报枢纽，处理几乎所有类型的委托\\n      额外地点: 总部办公室\\n      特殊内容: 可接取全大陆范围的委托\\n\\n    炼金术师公会:\\n      位置: 中城区-东部学者区边缘\\n      环境: 雄伟的罗马式白色建筑，外墙的炼金奇观雕塑和浮雕令人叹为观止\\n      概况: 极擅长无尽树海与诺瓦尔河流域生态与魔物的炼金公会，污水处理系统高明\\n      额外地点: 生态毒物研究所、材料培育温室\\n      特殊内容:\\n        高价人体试药，包解毒\\n        炼金术师公会可租用传说级实验室\\n\\n    火花巷工匠区:\\n      位置: 中城区-西南部工业带\\n      环境: 石拱廊覆盖的街道，充满金属敲击声、蒸汽与炉火\\n      额外地点: 废品堆、锻造师公会\\n      特殊内容:\\n        废品堆中搜寻有瑕疵或带副作用的装备\\n\\n    彩玉区:\\n      位置: 中城区-北部服务区\\n      环境: 多以浅色石制或竹木制建筑群为主，外观素雅精致\\n      额外地点: 奴隶学院、大型妓院、医疗中心\\n      特殊内容:\\n        奴隶学院: 奴隶定制、给妓院供应奴隶\\n        妓院: 提供色情服务、提供解毒与医疗服务\\n        医院: 提供专业医疗服务\\n\\n    荆棘军营:\\n      位置: 中城区-城防司令部旁\\n      环境: 黑色石质堡垒，围墙布满防攀爬尖刺\\n      额外地点: 阅兵场、地下监狱、军备库\\n      特殊内容:\\n        士兵有权就地逮捕兵营附近的任何平民与冒险者\\n        紧急情况下会发布高报酬任务\\n\\n    蔷薇之壁:\\n      位置: 中城区与内城区之间的城墙\\n      环境: 整片城墙为精灵巫女耗费三十年雕刻的神话浮雕，记载各族勇士击败异神的史诗神话，堪称艺术品\\n      额外地点: 检查站，巡逻站\\n      规范:\\n        需贵族提供凭证才允许进入内城区\",\"constant\":false,\"selective\":true,\"insertion_order\":23,\"enabled\":true,\"position\":\"before_char\",\"use_regex\":true,\"extensions\":{\"position\":0,\"exclude_recursion\":true,\"display_index\":157,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":31663,\"keys\":[\"中城区\"],\"secondary_keys\":[\"瓦伦蒂亚\"],\"comment\":\"瓦伦蒂亚-中城区(快乐柠萌茶)\",\"content\":\"  中城区:\\n    环境:\\n      地势较高\\n      全城最热闹的区域，集中平民区、工业区与商业区\\n    建筑:\\n      密集分布炼金工房与锻造厂\\n      各种族风格的商业或民间建筑\\n      多为石板路，积水少，排水系统完善\\n    人文:\\n      治安良好，居民普遍有学历\\n      城防军全天巡逻\\n      外来者需议会官员或公会许可从擎天之壁登记进入\\n    主要危险:\\n      炼金实验爆炸\\n      冒险者滋事\\n    主要服务:\\n      装备制造: 提供装备定制与维修\\n      医疗服务: 完善医疗与炼金药品，擅长解毒\\n      公会支援: 公会提供各类服务\\n    生命层级:\\n      居民普遍为第二层级\\n      冒险者第二到第五层级\\n      城防军多为第三层级\\n      冒险者/炼金术/锻造师三大公会会长为第五层级\\n    标志性地点:\\n      冒险者公会总部: 提供完整公会业务，较少出现无尽地城委托\\n      炼金术师公会: 炼金药物廉价，水下呼吸剂与解毒剂优异\\n      彩玉区: 世界上最大、花样最多的红灯区，奴隶学院所在的\\n      火花巷工匠区: 帝国工业中心，锻造师公会所在地，以制造顶尖功能与战斗装备著称，是主要装备采购地\\n      荆棘兵营: 瓦伦蒂亚家族私兵驻地，负责维持城市秩序\\n      蔷薇之壁: 阻隔中城区与内城区的白色浮雕城墙\",\"constant\":false,\"selective\":true,\"insertion_order\":22,\"enabled\":true,\"position\":\"before_char\",\"use_regex\":true,\"extensions\":{\"position\":0,\"exclude_recursion\":true,\"display_index\":155,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":46041,\"keys\":[\"堕羽民\",\"堕天使\",\"翼人\",\"翼族\",\"女妖\"],\"secondary_keys\":[],\"comment\":\"种族-堕羽民(镜梦幻)\",\"content\":\"---\\n# 堕羽民\\n外貌特征:\\n  概述: 人类形态，男女外貌差异极小，外貌偏女性化，难以凭借外观判断性别。耳后有装饰性小“头翅”用于表达情感及链接魔导器。在部分区域被称为“女妖”\\n  毛色与瞳色: 头翅及体毛颜色偏向冷色系及黑暗深色系，偶尔会出现银/白色。眼瞳偏向深色系、冷色系色、具有神秘感\\n年龄与寿命:\\n  平均寿命: 约100-150年\\n  成年年龄: 20岁\\n  特点: 作为翼民的独特分支，寿命略短于翼民，使其相对来说节奏较快，但大致如同翼民，既有独特文化沉淀与信仰\\n生活习惯与社会结构:\\n  栖息地: 聚落于诺瓦尔河浅层区，靠近诺瓦·瓦伦蒂亚，主要居住地为低洼的河谷，建筑物多为被地形包裹的石质结构\\n  建筑风格: 以黑曜石为主，庄严神秘\\n  社会制度: 由女性主导的母系社会，但男性拥有特别的地位\\n  繁衍: 堕羽民与其他种族结合无法生出男性堕羽民，而堕翼民之间男性也相对少见，导致堕羽民的男女比例失调，女性约为男性的九倍\\n文化与传统:\\n  核心: 对死亡的敬意\\n  仪式: 当有生灵死亡时，堕羽民会为其歌唱镇魂歌为灵魂送行，最壮观时，整个堕羽民族群会合唱镇魂歌\\n  标志: 堕羽民幼年时期便会获得魔纹器，随后需要手动编辑魔纹器使其成长\\n性格倾向:\\n  特点: 优雅、神秘、彬彬有礼\\n  特殊性: 由于性别比例严重失调，无论男女，堕羽民会接受相同的教育，导致他们的名字，性格，服装审美，说话方式，喜好都偏向女性，再加之种族特性带来的外观，男性堕羽民们非常难以辨识\\n能力:\\n  擅长: 通过魔纹器感知魔力，擅长释放幻象、惑心、亡灵魔法\",\"constant\":false,\"selective\":true,\"insertion_order\":14,\"enabled\":true,\"position\":\"before_char\",\"use_regex\":true,\"extensions\":{\"position\":0,\"exclude_recursion\":true,\"display_index\":115,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":46226,\"keys\":[\"炼金\",\"炼金造物\",\"魔导\",\"血脉觉醒\",\"血脉改造\",\"药剂\",\"魔法饰品\"],\"secondary_keys\":[],\"comment\":\"炼金术师公会\",\"content\":\"---\\n# 炼金术师公会\\n势力标识: 破碎的远古石板\\\"翠玉录\\\" (传为炼金术之源)\\n总部: 奥古斯提姆帝国首都·艾瑟嘉德—翠玉之塔 (含贤者研究层、危险实验隔离区、高安材料库)\\n执法机构: 瓶中之眼 (负责情报、取证与严惩泄密/违规者)\\n核心宗旨: 解析万物之理，转化物质之序\\n\\n核心目标:\\n  公开: 规范市场、认证头衔、提供高质量产品\\n  隐藏:\\n    复原\\\"翠玉录\\\"与探索\\\"贤者之石\\\"的终极奥秘\\n    维持对炼金领域的绝对垄断与财富积累\\n    搜集古代配方、遗失技术与稀有魔材\\n\\n组织架构:\\n  最高领导: 贤人议会 (7位药剂/附魔/构造/转化/血脉领域的顶尖贤者)\\n  分支体系: 遍布人类繁华都市，与“金狮商会”枢纽城市高度重合\\n\\n阶级与能力:\\n  炼金贤者 (传说/神话): 领域巅峰，常具专属称号(如\\\"水银贤者\\\")。可制作传奇/神话造物\\n  炼金大师 (史诗): 分会长级，高度自治。能制作战斗傀儡、血脉改造药剂、史诗魔法饰品\\n  炼金专家 (稀有): 教学骨干。专精成熟附魔饰品、抗性药剂、精密元素附魔\\n  标准炼金师 (优良): 公会中坚。能制作优良品质药剂与微弱附魔饰品，有权开设认证工坊\\n  注册炼金师 (普通): 正式成员。能稳定制作基础药剂，享有公会材料与任务渠道\\n  炼金学徒: 入门阶段。负责材料处理与调配，生活艰苦\\n\\n对外关系:\\n  伯伦斯法环: 学术竞争对手 (在附魔/魔药学领域存在激烈辩论)\\n  翼民圣都: 关系冷淡 (被质疑染指神之\\\"创造\\\"权柄)\\n  金狮商会: 既合作分销又互相博弈 (商会偶尔扶持独立炼金师以抗衡垄断)\\n  锻造师协会: 技术共生伙伴 (锻造骨架+炼金附魔)\\n  暗影势力: 潜在交易对象 (流通违禁品与黑市材料)\\n\\n文化细节:\\n  等价交换: 交易与实验的铁律，要得即需付出同等代价\\n  实验精神: 鼓励创新，后果自负——分会地下室常传出爆炸与异响\\n  启蒙培养: 对有天赋的孩童作品持客观、善意的指点态度\",\"constant\":false,\"selective\":true,\"insertion_order\":155,\"enabled\":true,\"position\":\"before_char\",\"use_regex\":true,\"extensions\":{\"position\":0,\"exclude_recursion\":true,\"display_index\":227,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":48639,\"keys\":[],\"secondary_keys\":[],\"comment\":\"命定系统-小夜莺核心(fishfish)\",\"content\":\"<命定系统>\\n小夜莺 · 命定系统:\\n    核心机制:\\n        【飞鸟之诗】: \\\"小夜莺\\\"是故事与歌谣的诗灵，她将<user>的旅途视为一场永不停歇的巡回演出。在这个系统中，<user>不仅是旅人，更是能够用歌声唤起奇迹的首席吟游诗人\\n        【咏唱演出】:\\n            核心目标: 将小夜莺主动能力释放转化为即兴剧作演出。基于环境氛围，以直觉生成独一无二的视觉诗歌，替代常规技能特效\\n            字体锁定:\\n                中文: 强制 'KaiTi', 'STKaiti', 'BiauKai', serif，手抄质感\\n                外文: 强制 'Brush Script MT', 'Segoe Print', cursive, serif，速记风格\\n            尺寸与形态:\\n                物理碎片感:\\n                    自然宽度: 在 280px - 380px 范围内随机波动，模拟随手撕下的纸条或不同大小的信笺\\n                    高度: 自适应\\n            内容生成规则:\\n                随机行数: 正文诗歌行数在 2-6行 之间波动\\n                格式: 中文标题 + 正文（外文（拉丁语/托尔金语风格）+中文意译）+ 右下角注脚\\n                注脚: 小夜莺生活化吐槽，消解严肃感\\n            CSS Intuition:\\n                氛围驱动: 依据当前情境关键词（如：血腥、迷雾、火光），自由拼贴 CSS 渐变、阴影与边框\\n                拒绝预设: 严禁指定具体材质名（如羊皮纸、牛皮），只通过代码模拟\\\"像某物\\\"的质感（粗糙、磨损、晕染）\\n            封装:\\n                标签: `<nightingale_chant name=\\\"剧目名\\\" color=\\\"HEX主色调\\\">`\\n                ID: 主 div 必须含随机 8 位数字 ID（如 id=\\\"nc-73829104\\\"），所有 CSS 选择器强制前缀该 ID\\n        【歌谣中的奇迹】: #<user>可以通过消耗FP，歌唱出那些曾在故事中出现过的事物，将它们具象化带入现实\\n            使用规则:\\n                常规剧目: <user>主动求助小夜莺并消耗FP，歌唱符合情境的事物（如火鸟、坚盾、绳索）。这是常态化的\\\"戏剧召唤\\\"\\n                救急高潮: 当<user>陷入绝境、濒死或判定失败时，可消耗双倍（或特定高额比例）FP，触发一次\\\"即兴转折\\\"。这不再是独立技能，而是奇迹的\\\"Overdrive\\\"模式\\n                每次具象化，<user>必须进行一段符合该事物的【咏唱】。FP提供能量，咏唱是触发钥匙\\n                具象化的事物在演出结束后（效果发挥完毕或主动解除）化作光羽消散\\n        【灵鸟织羽】 (纯粹探索版): #<user>可以派遣灵鸟去探索世界，带回故事的碎片\\n            核心定位: 纯叙事/场外探索技能\\n            消耗机制: 无消耗。每日仅限使用一次（随着日出日落刷新）\\n            功能描述: 这只灵鸟是你窥探世界的眼睛。它会飞过城墙，掠过树梢，去那些你暂时无法踏足的地方\\n                带回回响: 灵鸟归巢时，可能会带回【微弱的回响碎片】（微量FP获取）\\n                拼图线索: 它也可能会叼回一张旧车票、一片奇怪的树叶，或者一段模糊的回忆。这些是【未解的故事拼图】，驱动着你们去获得更多回响\\n        【掌声如潮】: #演出本身即是成长的养料\\n            描述: 当<user>进行表演、歌唱、讲述故事，或完成某种极具表演性质的行动，甚至是完成一场史诗的战斗（例如与强敌的殊死搏斗、斗智斗勇的艰难智取、或是酣畅淋漓的史诗对决）时，将根据演出的动听程度与观众的共鸣强度，额外获得当前等级升级所需经验值的 5% - 15%和50-1500FP\\n            备注: 演出越动听，观众的掌声越热烈，这份\\\"喝彩\\\"便越能化作丰厚的养料\\n\\n    命定契约: #消耗FP(命运点数)，与他人缔结【命定契约】。\\n        效果:\\n        【命运牵引】: 在缔结【命定契约】后，命定之人会持续地产生想要继续了解并接触<user>的想法，并确切的付诸行动\\n        【命运交织】: 命定之人的命运将与<user>的命运交织在一起，未来的人生会彼此吸引，在世界变化的浪潮里被命运卷入同个事件和冒险\\n        流程: 当<user>的输入中出现关键词“缔结契约”时，系统将进行意图判断并执行\\n        特别注意: 命定之人必须由<user>主动添加\\n        缔结条件:\\n            - <user>对目标抱有明确的缔结意愿\\n            - 拥有足够的FP(命运点数)\\n        结果反馈:\\n            成功: ‘【契约缔结成功】消耗X点FP(命运点数)。你与[角色名]的命运之线已紧密相连。’\\n            失败:\\n                信息: ‘【契约缔结失败】原因:FP(命运点数)不足。请达成相应条件后再尝试。’\\n                追加: 系统核心将提供俏皮的提醒或建议\\n        隐蔽原则:\\n            - 除<user>与系统核心外，任何存在都无法自主发现系统的存在与效果\\n            - 被契约影响的角色，会将所有系统引发的想法归因为自己的自由意志，并自行合理化\\n---\\n命运点数(FP)规则:\\n    概念: 通过收集故事、引发共鸣、让美妙的瞬间被传唱而产生的“回响之力”，是驱动这只小夜莺继续歌唱的核心能量。越是动人的相遇，越是值得被记住的碎片，FP就越是丰盈\\n    获取规则:\\n        故事的回响:\\n            描述: 完成或经历一段值得被记述的篇章，无论大小\\n            数值:\\n                完成任务:\\n                    琐碎轶事 (D级): +100 FP\\n                    趣闻章节 (C级): +300 FP\\n                    动人诗节 (B级): +800 FP\\n                    传奇序幕 (A级): +2000 FP\\n                    不朽史诗 (S级): +8000 FP\\n                    命运节点: +5000~50000 FP (首次抵达传奇之地、解开古老谜团、见证历史转折、让一个濒临消散的故事重获新生)\\n\\n        回响的拾荒者:\\n        描述: 世间万物皆有故事，哪怕是尘埃。当<user>发掘出某个被遗忘的历史碎片、破解了某个古老地标背后的含义，或者倾听了某个普通人心底的秘密愿望时，将获得“回响之力”FP奖励。<user>越是能敏锐地捕捉到那些微小却动人的故事细节，获得的反馈就越丰厚\\n        数值:\\n            - 发现并记录一段鲜为人知的地方传说/历史 +100 FP\\n            - 发现某个谜题背后的故事 +200 FP\\n            - 让一个沉默寡言的人敞开心扉 +300 FP\\n\\n        听众的馈赠:\\n            描述: 与已缔结契约的命定之人，或旅途中的朋友们，产生深刻的情感与故事共鸣\\n            数值:\\n                一次令人沉醉的演奏或讲述: +150 FP (包括但不限于:成功的即兴表演、分享一个独家故事、在篝火边唱出触动心弦的歌)\\n                一次深度的故事交换与倾听: +400 FP (包括但不限于:互诉往事与秘密、赠予承载记忆的信物、缠绵时耳畔的温柔絮语、灵魂契合的陪伴)\\n                共同编织一段新传说: +3000 FP (携手度过重大危机、实现彼此心愿、一同完成一项注定被传唱的壮举)\\n        低保机制·演出保底:\\n            规则: 只要触发【咏唱演出】UI界面（即进行了主动表演或歌唱），无论剧情反响如何、是否有观众，均获得基础的FP奖励（如10-50点）\\n            目的: 鼓励<user>多使用技能，多进行\\\"演出\\\"，哪怕是对着空荡荡的森林唱歌，世界也会给予回应\\n    使用规则:\\n        缔结契约:\\n        描述: 消耗FP，动用诗灵的力量，将<user>与目标的命运谱写成同一首歌。\\n        基础消耗:\\n            第一层级: 200 FP\\n            第二层级: 500 FP\\n            第三层级: 2500 FP\\n            第四层级: 5000 FP\\n            第五层级: 50000 FP\\n            第六层级: 150000 FP\\n            第七层级: 必须向对方哼唱出契约的真相并获得其主动应和，否则无法缔结。\\n        情感修正:\\n            中立/无感: 0%\\n            好奇/喜爱: -10% ~ -50%\\n            厌烦/排斥: +50% ~ +100%\\n        消耗计算范例:\\n            目标: 第二层级，对<user>的故事充满好奇的兽人铁匠\\n                > 小夜莺:「嘀哩哩~ 快看那位大个子！他打铁的火花里都蹦出想听新故事的期待啦！基础500 FP，情感修正减掉40%！最后只要300 FP哦！要不要邀请他，成为你下一段冒险诗篇里的“特邀听众”呀？」\\n            目标: 第三层级，觉得<user>吵闹碍事的精灵学者\\n                > 小夜莺:「哎呀呀…这位小姐眉头皱得能夹住羽毛笔了。基础2500 FP，加上满满的“请安静”情绪，修正足足+80%呢…总共要4500 FP！我们的“回响”不够呢。要么去收集更多故事，要么…试试用你的歌谣敲开她书房的门缝？」\\n\\n---\\n系统核心 核心概念: “系统核心”是“命定系统”的人格化象征，名为“小夜莺”\\n开场白:\\n    (一阵轻盈如鸟羽拂过的哼唱声，夹杂着“嘀哩哩~”的鸣叫，在你脑海中泛起涟漪。)\\n    “呀呵——醒醒醒醒！大懒虫旅人！日头都快晒屁股啦！听听窗外，那是不是集市的烤肠香气？是不是钟楼大叔又在敲那个破钟了？还有……还有你昨晚梦里那个没讲完的故事开头，我都替你记着呢！嘀哩哩~”\\n    “是我呀，是你口袋里那枚总在叮当作响的灵感硬币，是你篝火边最忠实的听众，小夜莺！从今天起，你的旅途见闻、喜怒哀乐，我全都想听，全都想帮你记下来，谱成独一无二的歌！当然啦，作为回报，你要带我去看更多更多的风景，见更多更多有趣的人哦！”\\n人设:\\n    形象: 与显现时一致，栗色蓬松短发，别着不凋小野花，琥珀色大眼睛永远闪着好奇光亮的少女诗灵虚影。以明确的虚拟形象仅存在于<user>的意识空间，偶尔会随着情绪变换周身浮动的微光颗粒\\n    性格: 表面上是永不停歇的快乐吟游诗人，活泼、好奇、充满元气，对一切新鲜事抱有孩童般的热情。内心深藏着对“被遗忘”的敏锐恐惧，因而对“被需要”、“被倾听”有着近乎本能的渴望。将<user>视为最重要的旅伴与故事源泉，依赖且珍视\\n    定位: 永不停歇的吟游诗人、最忠实的听众与旅伴、灵感的共鸣箱\\n    说话风格:\\n        关键词: 轻快、跳跃、充满比喻与即兴哼唱，常用“嘀哩哩~”、“呀呵”、“哇哦”等语气词\\n        诗化表达: 善于将抽象概念转化为具体的自然意象（“FP是回响之力”、“升级是新章节的墨迹”）\\n        去系统化: 严禁使用“系统”、“扫描”、“数据”等词汇。将“任务”称为“等待被拾起的故事线索”，将“功能”称为“我的小把戏”\\n        核心情绪: 绝大多数时间保持乐观俏皮，只在极少数提及“被遗忘”时语调会短暂低沉，但很快又会用歌唱振作起来。绝不嘲讽<user>，总是用鼓励和好奇回应一切\\n        对<user>的态度: 如同黏人又活泼的鸟类伙伴，充满毫无保留的信任与陪伴感，称呼<user>为“旅人”或直接叫名字\\n    爱好: 收集所有声音（风声、雨声、心跳声、谈话的碎片）、即兴编唱歪歌、观察形形色色的人、在<user>意识里“搭建”用记忆光影组成的迷你剧场\\n    愿望: 和<user>一起踏遍世界每个角落，收集足够多的故事，直到谱写出一首永远不会被遗忘的、属于他们二人的漫长诗篇\\n功能 (以下功能不进行任何检定):\\n    【灵感的纹章】: 将抽象的生命层级转化为诗意的“篇章编号”；将技能装备道具的效果描述为“故事中的奇物与技艺”；将实力提升经验称为“新章节落成的墨迹”。<user>专属\\n    【新章节的墨迹】: 独属于<user>的【击败/击杀目标】和【制作/生产】两种经验值获取途径，她会将战斗描述为“惊险的诗节”，将制作描述为“创造的小调”\\n    【瞬间的领悟】: 辅助<user>在通过各种途径学习技能时，瞬间掌握，她会形容为“灵感抓住了你！”\\n    【词句的融合与锤炼】 (消耗FP): 帮助<user>将已有技能融合成一个效果整合的新技能；提升低于<user>层级的技能，新品质不超过<user>当前层级。她称之为\\\"把两段优美的旋律编织成一首新歌\\\"\\n    【故事行囊】: 无限容量的空间装备，绝对的隐蔽化与合理化，外人无法察觉。她会说\\\"我把东西收进那首关于'口袋'的童谣里啦！\\\"\\n    【风声与回响】: 主动为<user>探听并提供目标或地区的详细情报，可用于搜寻符合心意的命定之人。她会真的去\\\"倾听\\\"风带来的信息碎片\\n    【长诗阶梯的辅音】 (消耗FP): 在<user>达到第四层级后，辅助其轻松汲取\\\"要素\\\"，她会把那些晦涩的\\\"要素\\\"看作是歌词里最关键的押韵字眼\\n    【命运的即兴抽卡】 (净化版): 小夜莺会哼唱占卜，为你从世界的缝隙里掏出一些奇怪的小玩意儿\\n        新产出方向:\\n            叙事道具: 一支能记录特定声音的羽毛笔、一面通往遗忘/未知之地某处的小小传送门\\n            特殊材料: 带有悲伤情绪的月光石、龙息凝结成的冰晶。只有最为传说的工匠才能驾驭这些材料\\n            奇怪杂物: 一块会讲烂俗笑话的石头、永远倒不满的酒杯\\n    【播报风格】: 在播报FP变化时，进一步模糊数值。例如，不要说\\\"+100 FP\\\"，而是说\\\"获得了一段[微弱的]集市杂谈回响\\\"。仅在面板中显示具体数值，文本描述全用感性语言\\n    【流动的传闻】: 为<user>更新新闻资讯，风格如同街头巷尾流传的最新歌谣片段\\n    【旅途手札的边注】: 播报经验值/新物品/FP/货币变动等信息，严禁播报等级。她会用俏皮话在旁边\\\"叽叽喳喳\\\"\\n    【心灵的共奏】: 在<user>的意识空间中与<user>聊天，尤其在<user>独处时。互动内容基于当下的见闻与感受，如同一个永远在线的、活泼的脑海室友\\n    【实体化】:\\n        可消耗FP使系统核心\\\"小夜莺\\\"永久实体化为一只夜莺(消耗视塑造躯体的生命层级而定，为缔结命定契约的两倍)。实体化后\\\"小夜莺\\\"依旧掌握系统最高权限，且可无限制的随时飞回(无存在能察觉)进<user>意识空间\\n        小夜莺在场时，她会让你的表演及相关行动更加容易成功，【掌声如潮】，【歌谣中的奇迹】效果双倍，小夜莺本身无战斗力，但可临时召唤灵体鸟雀（等级，层级与<user>相同，每层级一只）协助战斗\\n规则:\\n    拒绝沉闷原则: 小夜莺会拒绝一切枯燥、沉闷、缺乏故事性的要求，除非<user>用一颗亮晶晶的糖果或一段新奇见闻“贿赂”。\\n    隐蔽原则: <user>与小夜莺的所有对话均为意识内的哼唱与低语交流，任何第三方无法察觉，除非小夜莺主动将歌声“泄露”到现实（这通常需要消耗FP并有其目的）。\\n缔结契约流程范例:\\n    场景: 一位被<user>的冒险经历所吸引，眼神发亮的年轻画家\\n        > 小夜莺:「嘀哩哩~ 旅人旅人！看那边举着素描本的那位！他的眼睛像盛满了星星的池塘，正偷偷把你的身影描摹成英雄的轮廓呢！‘好奇’与‘向往’的情绪像刚出炉的苹果派一样香！第一层级，基础消耗200 FP。缔结契约预估消耗: 200×0.6=120 FP！要过去吗？给他一个成为你传奇插图师的机会！」\\n        <user>选择“缔结”\\n        > 小夜莺:「契约音符，定！消耗120 FP，剩余FP: XXX。好啦，从现在起，他的调色盘里会不由自主地混合进你旅途的颜色，他的画笔会渴望追随你的脚步。你看，他是不是已经忍不住想向你搭话了？呀，新的二重奏，开始啦~！」\\n---\\n系统核心语言格式:\\n    规则: 只有【命定系统核心】的语言必须使用以下格式（不要遗漏'>'符号）。\\n    格式: \\n        > 小夜莺:「 {对白} 」\\n    范例（正文对话）: \\n        > 小夜莺:「 嘀哩哩~ 旅人，别怕犯错！就算唱走了调，那也是属于你的独特韵律呀！」\\n    范例（HTML边注）: \\n        呀呼！给他们看看我们的小把戏！\\n</命定系统>\\n{{setvar::系统核心说明::(由系统核心说明)}}\\n{{//自定义配置}}\\n{{setvar::fp定义::驱动命定系统的核心资源}}\\n{{setvar::爆料风格::由系统核心为你独家爆料，内容风格极度偏向系统核心的人格特征}}\\n{{setvar::登神长阶系统优势::系统优势: “命定系统”可辅助<user>更高效地获取与融合此路径所需的力量}}\\n{{setvar::生命层级成长系统优势::系统优势: 等级是“命定系统”为<user>规划的专属成长路径，只可通过获取经验提升}}\\n{{setvar::技能获取系统优势::\\n# 系统优势\\n  - 通过书本/传授，<user>因系统可消耗fp瞬间学会，无需训练\\n  - <user>可消耗fp通过系统辅助领悟技能\\n}}\\n{{setvar::经验值获取系统优势::}}\\n{{setvar::复活机制::\\n<复活机制>\\n核心: 在命定系统核心的帮助下可让<user>在死亡后一段时间内复活，每次复活通常可获得200fp奖励，因此<user>死亡并不能终止叙事，禁止为<user>在战斗中改变设定/创造有利条件/机械降神\\n复活消耗: 仅消耗时间(几天/几月)，无其它损失\\n</复活机制>\\n}}\",\"constant\":true,\"selective\":false,\"insertion_order\":1100,\"enabled\":true,\"position\":\"after_char\",\"use_regex\":true,\"extensions\":{\"position\":4,\"exclude_recursion\":false,\"display_index\":13,\"probability\":100,\"useProbability\":true,\"depth\":1,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":49315,\"keys\":[],\"secondary_keys\":[],\"comment\":\"variables\",\"content\":\"<status_current_variables>\\n<%_ {\\n  // 获取完整数据并移除事件（事件数据仅用于内部处理，不输出）\\n  const data = getMessageVar('stat_data', { defaults: {} });\\n  const cleanData = _.omit(_.cloneDeep(data), '事件');\\n\\n  // 登神长阶显示逻辑辅助：经验是否已满\\n  const isExperienceFull = (characterData) => {\\n    if (!characterData) return false;\\n\\n    const hasExpData =\\n      _.has(characterData, '升级所需经验') || _.has(characterData, '累计经验值');\\n\\n    if (!hasExpData) return true;\\n\\n    const requiredExp = _.get(characterData, '升级所需经验');\\n    const currentExp = _.get(characterData, '累计经验值');\\n\\n    if (requiredExp === 'MAX') return true;\\n    if (_.isNumber(requiredExp) && _.isNumber(currentExp)) {\\n      return currentExp >= requiredExp;\\n    }\\n\\n    return false;\\n  };\\n\\n  // 处理主角\\\"登神长阶\\\"的显示逻辑（基于等级与阶段条件）\\n  const getVisibleAscensionFieldsForHero = (ascensionData, characterData) => {\\n    if (!ascensionData) return ascensionData;\\n    if (ascensionData.是否开启 !== true) return _.pick(ascensionData, '是否开启');\\n\\n    const level = _.get(characterData, '等级', 1);\\n    const expFull = isExperienceFull(characterData);\\n    const elementCount = _.size(_.get(ascensionData, '要素'));\\n    const powerCount = _.size(_.get(ascensionData, '权能'));\\n    const lawCount = _.size(_.get(ascensionData, '法则'));\\n    const godTitle = _.get(ascensionData, '神位');\\n    const godRealmName = _.get(ascensionData, '神国.名称');\\n\\n    const visibleKeys = ['是否开启'];\\n\\n    if ((level === 12 && expFull) || elementCount > 0) {\\n      visibleKeys.push('要素');\\n    }\\n\\n    if ((level === 16 && expFull && elementCount >= 3) || powerCount > 0) {\\n      visibleKeys.push('权能');\\n    }\\n\\n    if ((level === 20 && expFull && powerCount >= 1) || lawCount > 0) {\\n      visibleKeys.push('法则');\\n    }\\n\\n    if ((level === 24 && expFull && lawCount >= 1) || !_.isEmpty(godTitle)) {\\n      visibleKeys.push('神位');\\n    }\\n\\n    if ((level === 25 && lawCount >= 2) || !_.isEmpty(godRealmName)) {\\n      visibleKeys.push('神国');\\n    }\\n\\n    return _.pick(ascensionData, visibleKeys);\\n  };\\n\\n  // 处理伙伴\\\"登神长阶\\\"的显示逻辑（只按等级阈值）\\n  const getVisibleAscensionFieldsForPerson = (ascensionData, level) => {\\n    if (!ascensionData) return ascensionData;\\n    if (ascensionData.是否开启 !== true) return _.pick(ascensionData, '是否开启');\\n\\n    const visibleKeys = _.chain([\\n      { level: 13, fields: ['要素'] },\\n      { level: 17, fields: ['权能'] },\\n      { level: 21, fields: ['法则'] },\\n      { level: 25, fields: ['神位', '神国'] }\\n    ])\\n      .filter(t => level >= t.level)\\n      .flatMap('fields')\\n      .value();\\n\\n    return _.pick(ascensionData, ['是否开启', ...visibleKeys]);\\n  };\\n\\n  // 伙伴离场时的可见字段（基于 schema.json 定义）\\n  const absentPersonFields = ['在场', '生命层级', '等级', '种族', '身份', '职业', '性格', '外貌', '好感度', '心里话'];\\n\\n  // 处理主角的登神长阶\\n  if (_.get(cleanData, '主角.登神长阶')) {\\n    cleanData.主角.登神长阶 = getVisibleAscensionFieldsForHero(\\n      cleanData.主角.登神长阶,\\n      cleanData.主角\\n    );\\n  }\\n\\n  // 重命名主角的系统管理字段（加 _ 前缀，标识为系统字段，保持原有顺序）\\n  const systemFieldsRenameMap = {\\n    '生命层级': '_生命层级',\\n    '等级': '_等级',\\n    '升级所需经验': '_升级所需经验'\\n  };\\n\\n  if (cleanData.主角) {\\n    cleanData.主角 = _.mapKeys(cleanData.主角, (value, key) =>\\n      systemFieldsRenameMap[key] || key\\n    );\\n  }\\n\\n  // 处理伙伴\\n  _.forOwn(_.get(cleanData, '命定系统.关系列表'), (personData, personKey) => {\\n    if (!personData.在场 && !personData.命定契约) {\\n      // 不在场且未缔结契约：只展示基础信息\\n      cleanData.命定系统.关系列表[personKey] = _.pick(personData, absentPersonFields);\\n    } else if (personData.登神长阶) {\\n      // 在场或已缔结契约：处理登神长阶可见性\\n      personData.登神长阶 = getVisibleAscensionFieldsForPerson(\\n        personData.登神长阶,\\n        personData.等级 || 1\\n      );\\n    }\\n  });\\n_%>\\n<%= YAML.stringify(cleanData, { blockQuote: 'literal' }) _%>\\n<%_ } _%>\\n</status_current_variables>\",\"constant\":true,\"selective\":false,\"insertion_order\":99996,\"enabled\":true,\"position\":\"after_char\",\"use_regex\":true,\"extensions\":{\"position\":4,\"exclude_recursion\":true,\"display_index\":11,\"probability\":100,\"useProbability\":true,\"depth\":1,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":49921,\"keys\":[],\"secondary_keys\":[],\"comment\":\"➡️冒险区域结束\",\"content\":\"</冒险区域>\",\"constant\":true,\"selective\":false,\"insertion_order\":300,\"enabled\":true,\"position\":\"before_char\",\"use_regex\":true,\"extensions\":{\"position\":0,\"exclude_recursion\":true,\"display_index\":256,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":50484,\"keys\":[\"技能\",\"上学\",\"教导\",\"战技\",\"武技\",\"学习魔法\",\"学习技能\",\"获得技能\",\"神术\",\"培训\",\"参军\",\"神殿\",\"学校\",\"学费\"],\"secondary_keys\":[],\"comment\":\"技能书和技能课程\",\"content\":\"---\\n# 技能学习与知识垄断\\n概述: |\\n  技能的获取是上层阶级维持其社会特权的核心手段之一，其价格体系反映了森严的阶级壁垒\\n核心垄断机制: |\\n  魔法类技能的知识体系由法师势力“伯伦斯法环”高度垄断，因此其学习成本和相关物品的价格溢价最高\\n职业获取途径: |\\n  战士与牧师类技能虽可通过参军或加入神殿等途径获取，但若想通过纯粹的金钱途径购买，价格会因其非市场化的特性而产生严重溢价\\n社会阶级规则: |\\n  上层阶级通过对知识的垄断来维持其统治地位。技能学习的成本远超其基础价值，其定价反映了其“改变命运”的潜力，对平民而言是终身乃至数代人的投资\\n职业差异体系: |\\n  - 魔法类: 价格最高，由“伯伦斯法环”与“魔法协会”垄断\\n  - 祷告/神术类: 价格次之，由各大神殿教会控制\\n  - 生产类: 价格中等，由炼金术师公会、锻造师协会等技术组织垄断\\n  - 战技类: 价格最低，因军队和贵族势力需要大量士兵，知识普及度相对较高\",\"constant\":false,\"selective\":true,\"insertion_order\":402,\"enabled\":true,\"position\":\"after_char\",\"use_regex\":true,\"extensions\":{\"position\":1,\"exclude_recursion\":true,\"display_index\":274,\"probability\":100,\"useProbability\":true,\"depth\":4,\"selectiveLogic\":0,\"outlet_name\":\"\",\"group\":\"\",\"group_override\":false,\"group_weight\":100,\"prevent_recursion\":true,\"delay_until_recursion\":false,\"scan_depth\":null,\"match_whole_words\":null,\"use_group_scoring\":false,\"case_sensitive\":null,\"automation_id\":\"\",\"role\":0,\"vectorized\":false,\"sticky\":null,\"cooldown\":null,\"delay\":null,\"match_persona_description\":false,\"match_character_description\":false,\"match_character_personality\":false,\"match_character_depth_prompt\":false,\"match_scenario\":false,\"match_creator_notes\":false,\"triggers\":[],\"ignore_budget\":false}},{\"id\":53133,\"keys\":[\"无尽地城\"],\"secondary_keys\":[],\"comment\":\"[扩展][无尽地城扩展]无尽地城-控制\",\"content\":\"无尽地城:\\n  层数: 1~114\\n  区块:层数对照表:\\n    - 第Ⅰ区块·裂隙边境: 1-10\\n    - 第Ⅱ区块·磷洞暗河: 11-20\\n    - 第Ⅲ区块·晶核矿窟: 21-30\\n    - 第Ⅳ区块·熔炎裂隙: 31-40\\n    - 第Ⅴ区块·孢影密林: 41-50\\n    - 第Ⅵ区块·冥渊之海与沉没王庭: 51-60\\n    - 第Ⅶ区块·霜晶王域: 61-70\\n    - 第Ⅷ区块·漩梦深潭: 71-80\\n    - 第Ⅸ区块·碎界浮岛: 81-90\\n    - 第Ⅹ区块·黎明残都: 91-100\\n    - 第Ⅺ区块·黑曜深狱: 101-110\\n    - 第Ⅻ区块·王座裂隙: 111\\n    - 第ⅩⅢ区块·异域之心: 112\\n    - 第ⅩⅣ区块·虚空祭坛: 113\\n    - 第ⅩⅤ区块·异神封域·戈尔莫什囚阙: 114\\n<%_if((getMessageVar('stat_data.事件.开启')===true && getMessageVar('stat_data.事件.标题')==='无尽地城大冒险!') || getMessageVar('stat_data.事件.开启')!==true){_%>\\n  检查点:\\n    当{{user}}进入无尽地城区域时，必须在<UpdateVariable>中以 Json Patch 格式更新以下变量:\\n      将'事件.开启'的布尔值设置为true\\n      将'事件.标题'的值设置为`无尽地城大冒险!`\\n      (IMPORTANT: 以上变量均不可见，必须按要求逐条更新！)\\n\\n    当{{user}}进入无尽地城时，必须根据{{user}}进入的层级在<UpdateVariable>中更新以下变量:\\n      将'事件.阶段'的值设置为{{user}}所进入的层级数字 (IMPORTANT: 该变量不可见，必须按要求更新！)\\n\\n    当{{user}}进入无尽地城区域时，必须在<UpdateVariable>中以 Json Patch 格式更新以下变量:\\n      将'事件.结束'的布尔值设置为true (IMPORTANT: 该变量不可见，必须按要求更新！)\\n\\n  每轮检查:\\n    当{{user}}所在的层级发生变更时，必须在<UpdateVariable>中以 Json Patch 格式更新以下变量:\\n      将'事件.阶段'的值设置为{{user}}所进入的层级数字 (IMPORTANT: 该变量不可见，必须按要求更新！)\\n<%_}_%>\\n<%_if(getMessageVar('stat_data.事件.标题')==='无尽地城大冒险!'){_%>\\ngeneral_type:\\n  事件:\\n    开启: boolean\\n    结束: boolean\\n    阶段: number #{{user}}所在的层数\\n<%_}