m-desc\\\"></div>\\n\\n        <div style=\\\"padding:15px; background:rgba(156,39,176,0.15); border-left:4px solid #9c27b0; color:#e1bee7; font-style:italic; border-radius:0 8px 8px 0;\\\" id=\\\"m-comment\\\"></div>\\n    </div>\\n</div>\\n\\n<script>\\n    const rawXml = `<root>$1</root>`;\\n    const skills = [];\\n    \\n    try {\\n        const parser = new DOMParser();\\n        const doc = parser.parseFromString(rawXml, \\\"text/xml\\\");\\n        const items = doc.getElementsByTagName(\\\"skill\\\");\\n        for(let i=0; i<items.length; i++) {\\n            skills.push({\\n                name: items[i].getElementsByTagName(\\\"name\\\")[0]?.textContent || \\\"未知\\\",\\n                type: items[i].getElementsByTagName(\\\"type\\\")[0]?.textContent || \\\"其它\\\",\\n                quality: items[i].getElementsByTagName(\\\"quality\\\")[0]?.textContent || \\\"其它\\\",\\n                cost: items[i].getElementsByTagName(\\\"cost\\\")[0]?.textContent || \\\"无消耗\\\",\\n                tags: items[i].getElementsByTagName(\\\"tags\\\")[0]?.textContent || \\\"\\\",\\n                effect: items[i].getElementsByTagName(\\\"effect\\\")[0]?.textContent || \\\"效果解析中...\\\",\\n                desc: items[i].getElementsByTagName(\\\"desc\\\")[0]?.textContent || \\\"暂无描述\\\",\\n                comment: items[i].getElementsByTagName(\\\"comment\\\")[0]?.textContent || \\\"...\\\"\\n            });\\n        }\\n    } catch(e) {}\\n\\n    const keyBtn = document.getElementById('silver-key-btn');\\n    const intro = document.getElementById('intro-stage');\\n    const container = document.getElementById('reward-container');\\n    const gateRoot = document.getElementById('gate-root');\\n    const modal = document.getElementById('modal-backdrop');\\n    const modalCard = document.getElementById('modal-card');\\n\\n    function getQualityClass(q) {\\n        if(q.includes('优良')) return 'orb-excellent';\\n        if(q.includes('稀有')) return 'orb-rare';\\n        if(q.includes('史诗')) return 'orb-epic';\\n        if(q.includes('传说')) return 'orb-legend';\\n        if(q.includes('神话') || q.includes('唯一')) return 'orb-mythic';\\n        if(q.includes('普通')) return 'orb-common';\\n        return 'orb-other';\\n    }\\n\\n    keyBtn.addEventListener('click', () => {\\n        keyBtn.classList.add('unlocking');\\n        intro.classList.add('intro-fadeout');\\n\\n        setTimeout(() => {\\n            intro.style.display = 'none';\\n            gateRoot.classList.add('open');\\n            \\n            setTimeout(() => {\\n                container.style.display = 'flex';\\n                render();\\n            }, 1500); \\n        }, 600);\\n    });\\n\\n    function render() {\\n        skills.forEach((s, i) => {\\n            const orb = document.createElement('div');\\n            const qClass = getQualityClass(s.quality);\\n            orb.className = `skill-orb ${qClass}`;\\n            orb.style.animation = `cosmic-birth 1.5s cubic-bezier(0.19, 1, 0.22, 1) forwards ${i * 0.4}s`;\\n            \\n            let tagsHtml = '';\\n            const tagMatches = s.tags.match(/\\\\[(.*?)\\\\]/g);\\n            if (tagMatches) {\\n                tagsHtml = tagMatches.map(t => `<span class=\\\"tag-pill\\\">${t.replace(/[\\\\[\\\\]]/g,'')}</span>`).join('');\\n            } else {\\n                tagsHtml = `<span class=\\\"tag-pill\\\">${s.tags}</span>`;\\n            }\\n            \\n            const nameClass = s.name.length > 8 ? 'value scroll' : 'value';\\n\\n            orb.innerHTML = `\\n                <div class=\\\"orb-icon\\\">🔮</div>\\n                <div class=\\\"info-layout\\\">\\n                    <div class=\\\"info-box box-name\\\">\\n                        <span class=\\\"label\\\">NAME</span>\\n                        <div class=\\\"value-container\\\">\\n                            <span class=\\\"${nameClass}\\\">${s.name}</span>\\n                        </div>\\n                    </div>\\n                    <div class=\\\"info-box box-type\\\">\\n                        <span class=\\\"label\\\">TYPE</span>\\n                        <span class=\\\"value\\\">${s.type}</span>\\n                    </div>\\n                    <div class=\\\"info-box box-cost\\\">\\n                        <span class=\\\"label\\\">COST</span>\\n                        <span class=\\\"value\\\">${s.cost}</span>\\n                    </div>\\n                    <div class=\\\"info-box box-tags\\\">\\n                        <span class=\\\"label\\\">TAGS</span>\\n                        <div style=\\\"display:flex; flex-wrap:wrap; justify-content:center; gap:4px;\\\">${tagsHtml}</div>\\n                    </div>\\n                </div>\\n                <div class=\\\"click-hint\\\">[ ${s.quality} ] · CLICK FOR INFO</div>\\n            `;\\n            orb.onclick = () => openModal(s, qClass);\\n            container.appendChild(orb);\\n        });\\n    }\\n\\n    function openModal(s, qClass) {\\n        document.getElementById('m-title').textContent = s.name;\\n        document.getElementById('m-sub').textContent = `— ${s.quality} · ${s.type} —`;\\n        \\n        let color = '#78909c';\\n        if(qClass.includes('common')) color='#b0c4de';\\n        if(qClass.includes('excellent')) color='#00e676';\\n        if(qClass.includes('rare')) color='#00bcd4';\\n        if(qClass.includes('epic')) color='#9c27b0';\\n        if(qClass.includes('legend')) color='#ffd700';\\n        if(qClass.includes('mythic')) color='#ff5252';\\n        \\n        modalCard.style.borderColor = color;\\n        modalCard.style.boxShadow = `0 0 30px ${color}40`;\\n        \\n        document.getElementById('m-effect').innerHTML = s.effect.replace(/\\\\n/g, '<br>');\\n        document.getElementById('m-desc').innerHTML = s.desc.replace(/\\\\n/g, '<br>');\\n        document.getElementById('m-comment').innerHTML = `<strong>阿比盖尔:</strong> \\\"${s.comment}\\\"`;\\n        modal.style.display = 'flex';\\n    }\\n\\n    document.getElementById('modal-close').onclick = () => modal.style.display = 'none';\\n    modal.onclick = (e) => { if(e.target === modal) modal.style.display = 'none'; }\\n</script>\\n</body>\\n</html>\\n```\\n\",\"trimStrings\":[],\"placement\":[2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":6},{\"id\":\"d15a5611-5ca2-4437-8477-6d98f9a8725d\",\"scriptName\":\"命定核心-妲丽安对话美化\",\"findRegex\":\"/<dalian name=\\\"(.*?)\\\" mood=\\\"(.*?)\\\">\\\\s*[「]?\\\\s*([\\\\s\\\\S]*?)\\\\s*[」]?\\\\s*<\\\\/dalian>/g\",\"replaceString\":\"<div class=\\\"phantom-library-container\\\"><div class=\\\"leather-texture\\\"></div><div class=\\\"magic-seal-bg\\\"></div><div class=\\\"book-spine-left\\\"></div><div class=\\\"book-spine-gold-line\\\"></div><div class=\\\"seal-complex\\\"><div class=\\\"lock-base\\\"></div><div class=\\\"chain-cross\\\"></div><div class=\\\"keyhole-glow\\\"></div><div class=\\\"page-float p1\\\"></div><div class=\\\"page-float p2\\\"></div><div class=\\\"page-float p3\\\"></div></div><div class=\\\"portrait-wrapper\\\"><div class=\\\"portrait-frame-square\\\"><div class=\\\"portrait-inner\\\" style=\\\"background-image: url('https://cdn.jsdelivr.net/gh/AkabaneSaki/myrepo@main/picture/dalian/$2.png');\\\"></div><div class=\\\"frame-overlay\\\"></div></div><div class=\\\"mobile-info\\\"><span class=\\\"gothic-name-mobile\\\">$1</span><div class=\\\"ornament-line-mobile\\\"></div></div></div><div class=\\\"content-wrapper\\\"><div class=\\\"gothic-header\\\"><div class=\\\"wax-seal\\\"></div><span class=\\\"gothic-name\\\">$1</span><div class=\\\"ornament-line\\\"></div></div><div class=\\\"page-body\\\">$3</div></div></div><style>@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=UnifrakturMaguntia&display=swap');.phantom-library-container{--dalian-black:#0f0f12;--dalian-red:#4a0404;--dalian-crimson:#720e1e;--dalian-gold:#c5a