-10%,5%)}60%{transform:translate(15%,0)}70%{transform:translate(0,10%)}80%{transform:translate(-15%,0)}90%{transform:translate(10%,5%)}100%{transform:translate(5%,0)}}\\n    @keyframes mech-spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}\\n    @keyframes star-spin{100%{transform:rotate(360deg)}}\\n    @keyframes blob-float{0%{transform:translate(0,0) scale(1)}100%{transform:translate(5%, 5%) scale(1.1)}}\\n    @keyframes sheen-pass { 0% { left: -100%; } 100% { left: 200%; } }\\n    @keyframes modal-pop { from{transform:scale(0.8);opacity:0} to{transform:scale(1);opacity:1} }\\n    @keyframes key-unlock { 0% { transform: rotate(0deg) scale(1); } 50% { transform: rotate(90deg) scale(1.2); } 100% { transform: rotate(180deg) scale(0); opacity: 0; } }\\n    @keyframes halo-expand { 0% { transform: scale(1); opacity: 0.5; } 100% { transform: scale(4); opacity: 0; } }\\n    @keyframes burst-flash { 0% { opacity: 0; transform: translate(-50%, -50%) scaleX(0.1); } 20% { opacity: 0.6; transform: translate(-50%, -50%) scaleX(1); width: 120%; } 100% { opacity: 0; transform: translate(-50%, -50%) scaleX(2); width: 200%; } }\\n    @keyframes cosmic-birth { 0% { opacity: 0; transform: perspective(1000px) rotateY(90deg) scale(0.5); filter: brightness(2) blur(10px); } 60% { opacity: 1; transform: perspective(1000px) rotateY(-10deg) scale(1.05); filter: brightness(1.2) blur(0); } 100% { opacity: 1; transform: perspective(1000px) rotateY(0deg) scale(1); filter: none; } }\\n    \\n    /* 符号动画 */\\n    @keyframes symbol-breathe { 0% { opacity: 0.1; transform: scale(1) rotate(0deg); } 100% { opacity: 0.3; transform: scale(1.1) rotate(5deg); } }\\n    @keyframes symbol-twinkle { 0%, 100% { opacity: 0.3; transform: scale(1); filter: blur(1px); } 50% { opacity: 0.8; transform: scale(1.3); filter: blur(0); } }\\n\\n    @media (max-width: 600px) {\\n        .gate-root { width: 100%; border-radius: 0; border: none; min-height: 100vh; }\\n        .reward-container { padding: 20px; gap: 15px; }\\n        .skill-orb { flex: 1 1 100%; max-width: 100%; height: auto; min-height: 380px; }\\n        .silver-key-btn { width: 90px; height: 90px; }\\n        .key-icon { font-size: 60px; }\\n        .gate-light-burst { top: 30vh; }\\n    }\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"gate-root\\\" id=\\\"gate-root\\\">\\n    <div class=\\\"bg-container\\\">\\n        <div class=\\\"void-base\\\"></div>\\n        <div class=\\\"noise-overlay\\\"></div>\\n        <div class=\\\"galaxy-arm arm-primary\\\"></div>\\n        <div class=\\\"galaxy-arm arm-secondary\\\"></div>\\n        \\n        \\n        <div class=\\\"symbol-layer\\\">\\n            \\n            <div class=\\\"magic-circle-group\\\">\\n                <div class=\\\"mc-ring mc-outer\\\"></div>\\n                <div class=\\\"mc-ring mc-mid\\\"></div>\\n                <div class=\\\"mc-ring mc-inner\\\"></div>\\n            </div>\\n            \\n            <div class=\\\"sym-ring\\\">\\n                <div class=\\\"sym-common sym-ring-item pos-n\\\">✦</div>\\n                <div class=\\\"sym-common sym-ring-item pos-s\\\">✧</div>\\n                <div class=\\\"sym-common sym-ring-item pos-e\\\">✦</div>\\n                <div class=\\\"sym-common sym-ring-item pos-w\\\">✧</div>\\n            </div>\\n            \\n            <div class=\\\"sym-common sym-floater sf-main\\\">⚝</div>\\n            <div class=\\\"sym-common sym-floater sf-1\\\">⚝</div>\\n            <div class=\\\"sym-common sym-floater sf-2\\\">★</div>\\n            \\n            <div class=\\\"sym-common sym-dust sd-1\\\">★</div>\\n            <div class=\\\"sym-common sym-dust sd-2\\\">☆</div>\\n            <div class=\\\"sym-common sym-dust sd-3\\\">✦</div>\\n            <div class=\\\"sym-common sym-dust sd-4\\\">✧</div>\\n            <div class=\\\"sym-common sym-dust sd-5\\\">⚝</div>\\n            <div class=\\\"sym-common sym-dust sd-6\\\">☆</div>\\n        </div>\\n\\n        <div class=\\\"chaos